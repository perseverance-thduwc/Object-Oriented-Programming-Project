digraph A { rankdir=LR; nodesep=0.5; ranksep=0.9;
 node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.2,0.12"];
 subgraph cluster_web { label="web/static  (HTML + CSS + JavaScript)  -  TANG HIEN THI"; style="rounded,filled"; fillcolor="#EBF5FB"; fontname="DejaVu Sans";
   ui [label="index.html / style.css\nart.js (hinh SVG)\nvi.js (them dau)\ngame.js (ve + bat su kien)", fillcolor="#D6EAF8"]; }
 subgraph cluster_srv { label="web/server.py  (Python)  -  TANG CAU NOI"; style="rounded,filled"; fillcolor="#FEF9E7"; fontname="DejaVu Sans";
   srv [label="HTTP server\nbien dich + chay engine\nchuyen lenh <-> JSON", fillcolor="#FCF3CF"]; }
 subgraph cluster_cpp { label="C++  -  TANG LOI (luat choi OOP)"; style="rounded,filled"; fillcolor="#E8F8F5"; fontname="DejaVu Sans";
   eng [label="web/engine/GameEngine\n(command <-> JSON, wraps Game)", fillcolor="#D1F2EB"];
   core [label="core/  (ALL game rules)\nGame (state machine)\nCharacter, Warrior, Mage, Archer,\nSpitter, Brute, AmoebaBoss\nItem, Weapon, Armor, Potion\nStatusEffect, Skill\nDungeonArena, Dice, CurvedActivity", fillcolor="#D1F2EB"]; }
 ui -> srv [label=" POST /api/cmd\n {\"cmd\":\"ATTACK 1\"}", fontsize=10];
 srv -> ui [label=" JSON trang thai", fontsize=10, style=dashed];
 srv -> eng [label=" stdin: 1 lenh/dong", fontsize=10];
 eng -> srv [label=" stdout: 1 dong JSON", fontsize=10, style=dashed];
 eng -> core [label=" uses Game\n(core classes)", fontsize=10];
 con [label="console/main.cpp\n(ban dong lenh)", fillcolor="#F4ECF7"]; con -> core [label=" cung dung core", fontsize=10];
}
