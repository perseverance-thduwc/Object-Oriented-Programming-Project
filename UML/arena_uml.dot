digraph UML {
 rankdir=BT; splines=true; nodesep=0.55; ranksep=1.0; compound=true;
 node [shape=plain, fontname="DejaVu Sans", fontsize=10];
 edge [fontname="DejaVu Sans"];
 graph [fontname="DejaVu Sans", labelloc=t, fontsize=18, label=<<B>UML Class Diagram &#8211; Arena Text-based RPG (PHY10609 / PET10001)</B><BR/><FONT POINT-SIZE="11">Theo ma nguon thuc te. Gach chan = static &#183; In nghieng = abstract / thuan ao &#183; &#9671; aggregation &#183; &#9670; composition &#183; &#9655; ke thua (is-a) &#183; net dut = phu thuoc</FONT>>];
std_exception [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>std::exception</B></TD></TR></TABLE>>];
GameException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDEDEC"><TR><TD ALIGN="CENTER"><B>GameException</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- message: string<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GameException(msg: string)<BR ALIGN="LEFT"/>+ ~GameException()  {throw()}<BR ALIGN="LEFT"/>+ what(): const char*  {redefined}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Dice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FEF9E7"><TR><TD ALIGN="CENTER"><B>Dice</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ defaultSides: const int = 6</U><BR ALIGN="LEFT"/>- iMyNumSides: int<BR ALIGN="LEFT"/>- iMyResult: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Dice()<BR ALIGN="LEFT"/>+ Dice(numSides: int)<BR ALIGN="LEFT"/>+ roll(): int<BR ALIGN="LEFT"/>+ getResult(): int<BR ALIGN="LEFT"/>+ getNumSides(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBF5FB"><TR><TD ALIGN="CENTER">{abstract}<BR/><I><B>Item</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mName: string<BR ALIGN="LEFT"/># mValue: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Item(name: string, value: int)<BR ALIGN="LEFT"/>+ ~Item()  {virtual}<BR ALIGN="LEFT"/>+ getName(): string<BR ALIGN="LEFT"/>+ getValue(): int<BR ALIGN="LEFT"/><I>+ applyItem(user: Character&amp;): void  = 0</I><BR ALIGN="LEFT"/><I>+ getItemType(): string  = 0</I><BR ALIGN="LEFT"/><I>+ getDescription(): string  = 0</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Weapon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBF5FB"><TR><TD ALIGN="CENTER"><B>Weapon</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mBonusAtk: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Weapon(name: string, value: int, bonusAtk: int)<BR ALIGN="LEFT"/>+ getBonusAtk(): int<BR ALIGN="LEFT"/>+ applyItem(user: Character&amp;): void<BR ALIGN="LEFT"/>+ getItemType(): string<BR ALIGN="LEFT"/>+ getDescription(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Armor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBF5FB"><TR><TD ALIGN="CENTER"><B>Armor</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mBonusArmor: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Armor(name: string, value: int, bonusArmor: int)<BR ALIGN="LEFT"/>+ getBonusArmor(): int<BR ALIGN="LEFT"/>+ applyItem(user: Character&amp;): void<BR ALIGN="LEFT"/>+ getItemType(): string<BR ALIGN="LEFT"/>+ getDescription(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Potion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBF5FB"><TR><TD ALIGN="CENTER"><B>Potion</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mHealAmount: int<BR ALIGN="LEFT"/>- mManaAmount: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Potion(name: string, value: int, healAmount: int,<BR ALIGN="LEFT"/>        manaAmount: int = 0)<BR ALIGN="LEFT"/>+ getHealAmount(): int<BR ALIGN="LEFT"/>+ getManaAmount(): int<BR ALIGN="LEFT"/>+ applyItem(user: Character&amp;): void<BR ALIGN="LEFT"/>+ getItemType(): string<BR ALIGN="LEFT"/>+ getDescription(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
StatusEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F4ECF7"><TR><TD ALIGN="CENTER">{abstract}<BR/><I><B>StatusEffect</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># mName: string<BR ALIGN="LEFT"/># mDuration: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ StatusEffect(name: string, duration: int)<BR ALIGN="LEFT"/>+ ~StatusEffect()  {virtual}<BR ALIGN="LEFT"/>+ getName(): string<BR ALIGN="LEFT"/>+ getDuration(): int<BR ALIGN="LEFT"/>+ isExpired(): bool<BR ALIGN="LEFT"/>+ decrementTurn(): void<BR ALIGN="LEFT"/><I>+ onTurnStart(target: Character&amp;): bool  = 0</I><BR ALIGN="LEFT"/><I>+ describe(): string  = 0</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PoisonEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F4ECF7"><TR><TD ALIGN="CENTER"><B>PoisonEffect</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mDamagePerTurn: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PoisonEffect(name, duration, damagePerTurn)<BR ALIGN="LEFT"/>+ onTurnStart(target: Character&amp;): bool<BR ALIGN="LEFT"/>+ describe(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
StunEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F4ECF7"><TR><TD ALIGN="CENTER"><B>StunEffect</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ StunEffect(name, duration)<BR ALIGN="LEFT"/>+ onTurnStart(target: Character&amp;): bool<BR ALIGN="LEFT"/>+ describe(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RegenEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F4ECF7"><TR><TD ALIGN="CENTER"><B>RegenEffect</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mHealPerTurn: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ RegenEffect(name, duration, healPerTurn)<BR ALIGN="LEFT"/>+ onTurnStart(target: Character&amp;): bool<BR ALIGN="LEFT"/>+ describe(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Skill [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F4ECF7"><TR><TD ALIGN="CENTER"><B>Skill</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ EFFECT_NONE = 0, EFFECT_POISON = 1, EFFECT_STUN = 2: const int</U><BR ALIGN="LEFT"/><U>+ EFFECT_REGEN = 3, EFFECT_DRAIN = 4: const int</U><BR ALIGN="LEFT"/>- mSkillName: string<BR ALIGN="LEFT"/>- mMpCost: int<BR ALIGN="LEFT"/>- mPower: int<BR ALIGN="LEFT"/>- mEffectType: int<BR ALIGN="LEFT"/>- mEffectDuration: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Skill(skillName: string, mpCost: int, power: int,<BR ALIGN="LEFT"/>      effectType: int = EFFECT_NONE, effectDuration: int = 3)<BR ALIGN="LEFT"/>+ getSkillName() / getMpCost() / getPower()<BR ALIGN="LEFT"/>+ getEffectType() / getEffectDuration()<BR ALIGN="LEFT"/>+ getDescription(): string<BR ALIGN="LEFT"/>+ createEffect(): StatusEffect*<BR ALIGN="LEFT"/>+ cast(caster: Character&amp;, target: Character&amp;, d: Dice&amp;): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Character [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F8F5"><TR><TD ALIGN="CENTER">{abstract}<BR/><I><B>Character</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ totalCharacters: int</U><BR ALIGN="LEFT"/><U>+ MAX_ITEMS = 6, MAX_SKILLS = 8, MAX_EFFECTS = 6: const int</U><BR ALIGN="LEFT"/># mName: string<BR ALIGN="LEFT"/># mMaxHealth, mHealth, mMaxMana, mMana: int<BR ALIGN="LEFT"/># mAttack, mArmor, mLevel, mX, mY: int<BR ALIGN="LEFT"/># mCritChance, mMissChance: int   // %<BR ALIGN="LEFT"/># mDefending: bool<BR ALIGN="LEFT"/># mInventory: Item*[MAX_ITEMS]<BR ALIGN="LEFT"/># mItemCount: int<BR ALIGN="LEFT"/># mSkills: Skill*[MAX_SKILLS]<BR ALIGN="LEFT"/># mSkillCount: int<BR ALIGN="LEFT"/># mActiveEffects: StatusEffect*[MAX_EFFECTS]<BR ALIGN="LEFT"/># mEffectCount: int<BR ALIGN="LEFT"/># mEquippedWeapon: Weapon*<BR ALIGN="LEFT"/># mEquippedArmor: Armor*<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Character(name: string, maxHealth: int = 100, maxMana: int = 30,<BR ALIGN="LEFT"/>      attack: int = 10, armor: int = 0)   // auto-adds skill Power Strike<BR ALIGN="LEFT"/>+ ~Character()  {virtual}<BR ALIGN="LEFT"/><U>+ getTotalCharacters(): int</U><BR ALIGN="LEFT"/><I>+ performAction(target: Character&amp;, d: Dice&amp;): int  = 0</I><BR ALIGN="LEFT"/><I>+ speak(): void  = 0</I><BR ALIGN="LEFT"/>+ scaleLevel(level: int): void  {virtual}<BR ALIGN="LEFT"/>+ getName() / getHealth() / getMaxHealth() / getMana() / getMaxMana()<BR ALIGN="LEFT"/>+ getAttack() / getArmor() / getLevel() / getX() / getY() / isAlive()<BR ALIGN="LEFT"/>+ setX(x) / setY(y) / setLevel(l) / setCritChance(p) / setMissChance(p)<BR ALIGN="LEFT"/>      : Character&amp;   // chained calls<BR ALIGN="LEFT"/>+ changeHealth(delta: int) / changeMana(delta: int): void<BR ALIGN="LEFT"/>+ takeDamage(rawDamage: int): int<BR ALIGN="LEFT"/>+ hitTarget(target: Character&amp;, raw: int, action: string, canMiss: bool): int<BR ALIGN="LEFT"/>+ defend() / endDefend(): void  ;  isDefending(): bool<BR ALIGN="LEFT"/>+ heal(amount: int): void<BR ALIGN="LEFT"/>+ heal(ratioOfMax: double): void<BR ALIGN="LEFT"/>+ addItem(item: Item*): bool<BR ALIGN="LEFT"/>+ itemAt(index: int): Item*<BR ALIGN="LEFT"/>+ useItem(index: int): void<BR ALIGN="LEFT"/>+ equipWeapon(w: Weapon*) / equipArmor(a: Armor*): void<BR ALIGN="LEFT"/>+ getEquippedIndex() / getEquippedArmorIndex(): int<BR ALIGN="LEFT"/>+ getWeaponBonus() / getArmorBonus() / getEffectiveAttack(): int<BR ALIGN="LEFT"/>+ addStatusEffect(effect: StatusEffect*): void<BR ALIGN="LEFT"/>+ processTurnEffects(): bool<BR ALIGN="LEFT"/>+ addSkill(skill: Skill*): bool<BR ALIGN="LEFT"/>+ hasSkill(name: string): bool<BR ALIGN="LEFT"/>+ skillAt(index: int): Skill*<BR ALIGN="LEFT"/>+ castSkill(index: int, target: Character&amp;, d: Dice&amp;): int<BR ALIGN="LEFT"/>+ printStatus() / printInventory(): void<BR ALIGN="LEFT"/>- Character(other: const Character&amp;)  {cam sao chep}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Warrior [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F8F5"><TR><TD ALIGN="CENTER"><B>Warrior</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Warrior(name, maxHealth, maxMana, attack, armor)<BR ALIGN="LEFT"/>+ performAction(target: Character&amp;, d: Dice&amp;): int<BR ALIGN="LEFT"/>+ speak(): void<BR ALIGN="LEFT"/>// unique skill: Shield Bash (stun)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Mage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F8F5"><TR><TD ALIGN="CENTER"><B>Mage</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mSpellPower: int<BR ALIGN="LEFT"/><U>- SPELL_MP_COST: const int = 10</U><BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Mage(name, maxHealth, maxMana, attack, armor, spellPower)<BR ALIGN="LEFT"/>+ performAction(target: Character&amp;, d: Dice&amp;): int<BR ALIGN="LEFT"/>+ speak(): void<BR ALIGN="LEFT"/>// unique skill: Venom Bolt (poison)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Archer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F8F5"><TR><TD ALIGN="CENTER"><B>Archer</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Archer(name, maxHealth, maxMana, attack, armor)  // crit 25%<BR ALIGN="LEFT"/>+ performAction(target: Character&amp;, d: Dice&amp;): int<BR ALIGN="LEFT"/>+ speak(): void<BR ALIGN="LEFT"/>// unique skill: Deep Breath (regen)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Spitter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDEDEC"><TR><TD ALIGN="CENTER"><B>Spitter</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Spitter(name, maxHealth, maxMana, attack, armor)<BR ALIGN="LEFT"/>+ performAction(target: Character&amp;, d: Dice&amp;): int   // poisons<BR ALIGN="LEFT"/>+ speak(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Brute [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDEDEC"><TR><TD ALIGN="CENTER"><B>Brute</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Brute(name, maxHealth, maxMana, attack, armor)    // miss 25%<BR ALIGN="LEFT"/>+ performAction(target: Character&amp;, d: Dice&amp;): int   // may stun<BR ALIGN="LEFT"/>+ speak(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AmoebaBoss [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDEDEC"><TR><TD ALIGN="CENTER"><B>AmoebaBoss</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mXPivot, mYPivot: int<BR ALIGN="LEFT"/>- mSpinPower, mSpinAngle, mActions: int<BR ALIGN="LEFT"/><U>- HIF_SOUND_ID: const int = 42</U><BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ AmoebaBoss(name, maxHealth, maxMana, attack, armor,<BR ALIGN="LEFT"/>      xPivot: int = 0, yPivot: int = 0)<BR ALIGN="LEFT"/>+ rotateAroundPivot(d: Dice&amp;): void<BR ALIGN="LEFT"/>+ performAction(target: Character&amp;, d: Dice&amp;): int   // 3-turn cycle<BR ALIGN="LEFT"/>+ speak(): void<BR ALIGN="LEFT"/>+ scaleLevel(level: int): void  {redefined}<BR ALIGN="LEFT"/>// unique skill: Toxic Storm (poison)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DungeonArena [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FEF5E7"><TR><TD ALIGN="CENTER"><B>DungeonArena</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MAX_FLOOR = 5, ITEM_KINDS = 6, SKILL_KINDS = 6: const int</U><BR ALIGN="LEFT"/>- mFloor: int<BR ALIGN="LEFT"/>- mEnemies: Character**<BR ALIGN="LEFT"/>- mEnemyCount: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ DungeonArena()<BR ALIGN="LEFT"/>+ ~DungeonArena()<BR ALIGN="LEFT"/>+ getFloor() / setFloor(f) / isLastFloor()<BR ALIGN="LEFT"/>+ spawnEnemies(d: Dice&amp;): void<BR ALIGN="LEFT"/>+ clearEnemies(): void<BR ALIGN="LEFT"/>+ enemyAt(index: int): Character*<BR ALIGN="LEFT"/>+ enemyCount() / livingEnemyCount(): int<BR ALIGN="LEFT"/>+ createItem(kind: int): Item*<BR ALIGN="LEFT"/>+ createSkill(kind: int): Skill*<BR ALIGN="LEFT"/>+ skillName(kind: int): string<BR ALIGN="LEFT"/>- createMinion(kind: int, number: int): Character*<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Game [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FEF5E7"><TR><TD ALIGN="CENTER"><B>Game</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TEAM_SIZE = 3: const int</U><BR ALIGN="LEFT"/><U>+ PHASE_CHOOSE_HERO / BATTLE / REWARD_TYPE / REWARD_PICK / OVER: const int</U><BR ALIGN="LEFT"/>- mHeroes: Character*[3]<BR ALIGN="LEFT"/>- mArena: DungeonArena<BR ALIGN="LEFT"/>- mD6: Dice<BR ALIGN="LEFT"/>- mPhase, mActive, mTurn, mCleared: int<BR ALIGN="LEFT"/>- mRewardType, mOffers[3], mOfferCount: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Game() / ~Game() / newGame()<BR ALIGN="LEFT"/>+ getPhase() / getActive() / getTurn() / getCleared(): int<BR ALIGN="LEFT"/>+ getHero(i): Character* / getArena(): DungeonArena&amp;<BR ALIGN="LEFT"/>+ aliveHeroes(): int / isVictory(): bool / canLearnSkill(): bool<BR ALIGN="LEFT"/>+ offerCount(): int / offerDescription(i): string<BR ALIGN="LEFT"/>+ getResult(raw&amp;, curved&amp;, letter&amp;): void<BR ALIGN="LEFT"/>+ selectHero(i) / attack(e) / useSkill(s, e) / useItem(k) / defend()<BR ALIGN="LEFT"/>+ chooseRewardType(t) / backToRewardType() / pickOffer(i)<BR ALIGN="LEFT"/>- beginHeroTurn() / endHeroAction() / enemyPhase()<BR ALIGN="LEFT"/>- floorWon() / heroDown() / makeOffers()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
GradedActivity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFEFE"><TR><TD ALIGN="CENTER"><B>GradedActivity</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># letter: char<BR ALIGN="LEFT"/># score: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># determineGrade(): void<BR ALIGN="LEFT"/>+ GradedActivity()<BR ALIGN="LEFT"/>+ setScore(s: double): void<BR ALIGN="LEFT"/>+ getScore(): double<BR ALIGN="LEFT"/>+ getLetterGrade(): char<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CurvedActivity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFEFE"><TR><TD ALIGN="CENTER"><B>CurvedActivity</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># rawScore: double<BR ALIGN="LEFT"/># percentage: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CurvedActivity()<BR ALIGN="LEFT"/>+ setPercentage(c: double): void<BR ALIGN="LEFT"/>+ setScore(s: double): void  {redefined}<BR ALIGN="LEFT"/>+ getRawScore(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
GameEngine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDEDEC"><TR><TD ALIGN="CENTER">&laquo;web bridge&raquo;<BR/><B>GameEngine</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mGame: Game<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GameEngine()<BR ALIGN="LEFT"/>+ handle(line: string): string  // command -&gt; JSON<BR ALIGN="LEFT"/>- dispatch(cmd: string, a: int, b: int): void<BR ALIGN="LEFT"/>- stateJson(log: string): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
